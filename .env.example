# --- PostgreSQL Settings -------------------------
POSTGRES_DB=automata
POSTGRES_USER=automata_user
POSTGRES_PASSWORD=your_strong_postgres_password

# --- Django Settings -----------------------------
# Generate a new secret key for your project
# e.g., run: python -c 'from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())'
SECRET_KEY=your_django_secret_key
DEBUG=True
DB_HOST=postgres
DB_PORT=5432
DB_USER=${POSTGRES_USER}
DB_PASSWORD=${POSTGRES_PASSWORD}
DB_NAME=${POSTGRES_DB}

# --- Celery Settings -----------------------------
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# --- MinIO Settings ------------------------------
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=your_strong_minio_password

# --- Directus (Example CRM API) Settings ---------
DIRECTUS_KEY=your_directus_key
DIRECTUS_SECRET=your_directus_secret
DIRECTUS_ADMIN_EMAIL=admin@example.com
DIRECTUS_ADMIN_PASSWORD=your_strong_directus_password
DIRECTUS_DB_NAME=directus_db
DIRECTUS_DB_USER=directus_user
DIRECTUS_DB_PASSWORD=your_strong_postgres_password


# --- Gitea ---

GITEA_DB_NAME=gitea
GITEA_DB_USER=gitea_user
GITEA_DB_PASSWORD=your_strong_postgres_password

# --- Integration API Keys & Tokens ---------------
# These will be used by your Python clients in the 'integrations' folder
OPENAI_API_KEY=sk-your_openai_api_key
# You will get this from the Gitea UI after setting up an admin user
GITEA_API_TOKEN=your_gitea_api_token
# You will get this from the Focalboard UI after setting up an admin user
FOCALBOARD_API_TOKEN=your_focalboard_api_token
